# Copy this file to .env and fill in real values. Never commit .env.

# ClickUp — Settings > Apps > API Token (personal token, starts with pk_)
CLICKUP_API_TOKEN=

# ClickUp identifiers for the project this bot manages
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=

# Slack app credentials (see docs/SETUP.md for how to create the app)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# MiniMax LLM
MINIMAX_API_KEY=

# Shared secret ClickUp returns when the webhook is registered (step 6 in
# docs/SETUP.md) — used by scripts/clickup-webhook-shim.js to verify ClickUp's
# X-Signature header. Leave blank until the webhook is registered.
CLICKUP_WEBHOOK_SECRET=

# Bearer token OpenClaw requires on its own inbound /hooks/* endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPENCLAW_HOOKS_TOKEN=

# Local port the ClickUp webhook shim listens on (default 8787).
CLICKUP_SHIM_PORT=8787
